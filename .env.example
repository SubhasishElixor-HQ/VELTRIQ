# Optional local-only, OpenAI-compatible chat completions endpoint, e.g. LM Studio.
# Leave empty for deterministic evidence summaries.
VEHICLEGPT_MODEL_URL=
VEHICLEGPT_MODEL_TIMEOUT_SECONDS=3
VEHICLEGPT_DATA_DIR=./data
POSTGRES_DB=vehiclegpt
POSTGRES_USER=vehiclegpt
POSTGRES_PASSWORD=replace_with_a_long_local_password
VEHICLEGPT_DATABASE_URL=postgresql://vehiclegpt:replace_with_a_long_local_password@127.0.0.1:5432/vehiclegpt
VEHICLEGPT_MAX_IMPORT_BYTES=10485760
VEHICLEGPT_MAX_IMPORT_RECORDS=100000
VEHICLEGPT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
